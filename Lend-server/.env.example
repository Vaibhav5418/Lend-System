# ─── Server Configuration ──────────────────────────────────────────
PORT=3001
JWT_SECRET=your-jwt-secret-change-in-production
FRONTEND_ORIGIN=http://localhost:5173

# ─── Database (Neon PostgreSQL) ────────────────────────────────────
# PostgreSQL connection string with SSL enabled
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
# DB_URI is also supported as an alias
DB_URI=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# ─── Optional: Source MongoDB (Only needed for data migration) ─────
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/lendflow?retryWrites=true&w=majority

# ─── Cloudinary Storage (Documents <= 10MB) ────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Supabase Storage (Documents > 10MB) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_DOCUMENTS=lendflow-documents

# ─── AI Engine (Groq API) ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
